#!/bin/sh
# Host-test mock for /usr/bin/cfst. Copies a fixture to -o and records argv.
set -eu

log_file="${CFST_MOCK_CFST_LOG:-}"
if [ -n "$log_file" ]; then
    directory="${log_file%/*}"
    if [ "$directory" != "$log_file" ] && [ -n "$directory" ]; then
        mkdir -p "$directory" 2>/dev/null || true
    fi
    {
        printf 'argv:'
        for arg in "$@"; do
            printf ' %s' "$arg"
        done
        printf '\n'
    } >> "$log_file"
fi

out=""
prev=""
for arg in "$@"; do
    if [ "$prev" = "-o" ]; then
        out="$arg"
    fi
    prev="$arg"
done

if [ -n "${CFST_MOCK_CFST_SLEEP:-}" ]; then
    sleep_cmd="${CFST_SLEEP_CMD:-sleep}"
    # Prefer real sleep for slow-child simulation even if CFST_SLEEP_CMD is stubbed.
    if [ -n "${CFST_MOCK_CFST_REAL_SLEEP:-}" ]; then
        sleep_cmd="$CFST_MOCK_CFST_REAL_SLEEP"
    fi
    "$sleep_cmd" "$CFST_MOCK_CFST_SLEEP" || true
fi

if [ -n "${CFST_MOCK_CFST_EXIT:-}" ]; then
    exit "$CFST_MOCK_CFST_EXIT"
fi

latency_only=0
for arg in "$@"; do
    [ "$arg" = "-dd" ] && latency_only=1
 done

fixture="${CFST_MOCK_CFST_FIXTURE:-}"
if [ "$latency_only" -eq 1 ]; then
    # Optional colon-separated sequence for adaptive preflight tests. The
    # final fixture is reused after the sequence is exhausted.
    sequence="${CFST_MOCK_CFST_PREFLIGHT_FIXTURES:-}"
    if [ -n "$sequence" ]; then
        count_file="${CFST_MOCK_CFST_PREFLIGHT_COUNT_FILE:-/tmp/cfst-mock-preflight-count}"
        count=0
        if [ -f "$count_file" ]; then
            count="$(cat "$count_file" 2>/dev/null || printf '0')"
        fi
        case "$count" in ''|*[!0-9]*) count=0 ;; esac
        count=$((count + 1))
        printf '%s\n' "$count" > "$count_file"
        fixture="$(printf '%s' "$sequence" | awk -F: -v n="$count" '{ if (n > NF) n = NF; print $n }')"
    elif [ -n "${CFST_MOCK_CFST_PREFLIGHT_FIXTURE:-}" ]; then
        fixture="$CFST_MOCK_CFST_PREFLIGHT_FIXTURE"
    fi
elif [ -n "${CFST_MOCK_CFST_DOWNLOAD_FIXTURE:-}" ]; then
    fixture="$CFST_MOCK_CFST_DOWNLOAD_FIXTURE"
fi

if [ -n "$fixture" ] && [ -n "$out" ]; then
    directory="${out%/*}"
    if [ "$directory" != "$out" ] && [ -n "$directory" ]; then
        mkdir -p "$directory" 2>/dev/null || true
    fi
    cp "$fixture" "$out"
fi

exit 0
