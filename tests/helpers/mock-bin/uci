#!/bin/sh
set -eu

if [ "${1:-}" = "-q" ]; then
    shift
fi

command="${1:-}"
[ -n "$command" ] || exit 1
shift

uci_file="${CFST_TEST_UCI_FILE:-}"

case "$command" in
    get)
        key="$1"
        [ -f "$uci_file" ] || exit 1
        value="$(awk -F= -v key="$key" '
            $1 == key {
                sub(/^[^=]*=/, "")
                print
                found = 1
                exit
            }
            END { if (!found) exit 1 }
        ' "$uci_file")" || exit 1
        printf '%s\n' "$value"
        ;;
    set)
        assignment="$1"
        case "$assignment" in
            *=*) ;;
            *) exit 1 ;;
        esac
        key="${assignment%%=*}"
        value="${assignment#*=}"
        [ -n "$uci_file" ] || exit 1
        directory="${uci_file%/*}"
        if [ "$directory" != "$uci_file" ] && [ -n "$directory" ]; then
            mkdir -p "$directory" 2>/dev/null || true
        fi
        touch "$uci_file"
        tmp="$uci_file.tmp.$$"
        awk -F= -v key="$key" -v value="$value" '
            BEGIN { updated = 0 }
            $1 == key {
                print key "=" value
                updated = 1
                next
            }
            { print }
            END {
                if (!updated) print key "=" value
            }
        ' "$uci_file" > "$tmp"
        mv -f "$tmp" "$uci_file"
        ;;
    delete)
        key="$1"
        [ -f "$uci_file" ] || exit 0
        tmp="$uci_file.tmp.$$"
        awk -F= -v key="$key" '
            $1 == key { next }
            { print }
        ' "$uci_file" > "$tmp"
        mv -f "$tmp" "$uci_file"
        ;;
    commit)
        package="${1:-}"
        [ -n "$package" ] || exit 1
        log="${CFST_TEST_UCI_COMMIT_LOG:-}"
        if [ -n "$log" ]; then
            directory="${log%/*}"
            if [ "$directory" != "$log" ] && [ -n "$directory" ]; then
                mkdir -p "$directory" 2>/dev/null || true
            fi
            printf '%s\n' "$package" >> "$log"
        fi
        ;;
    *)
        exit 1
        ;;
esac
