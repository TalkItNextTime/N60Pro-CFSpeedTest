@@ -0,0 +1,54 @@
+package utils
+
+import (
+	"os"
+	"strings"
+	"sync"
+)
+
+// LiveOutput 为 -live 参数指定的实时结果文件。每完成一个 IP 的延迟测速、
+// 每开始/完成一个 IP 的下载测速都会追加一行，供其他程序在测速过程中逐个 IP 展示：
+//
+//	P,IP,已发送,已接收,丢包率,平均延迟,地区码
+//	D,IP
+//	S,IP,下载速度(MB/s),地区码
+var LiveOutput = ""
+
+var (
+	liveMu   sync.Mutex
+	liveFile *os.File
+)
+
+func writeLive(fields ...string) {
+	liveMu.Lock()
+	defer liveMu.Unlock()
+	if LiveOutput == "" {
+		return
+	}
+	if liveFile == nil {
+		fp, err := os.OpenFile(LiveOutput, os.O_WRONLY|os.O_CREATE|os.O_APPEND, 0644)
+		if err != nil {
+			LiveOutput = "" // 无法写入时不再重试，不影响最终结果文件
+			return
+		}
+		liveFile = fp
+	}
+	_, _ = liveFile.WriteString(strings.Join(fields, ",") + "\n")
+}
+
+// LivePing 记录一个完成延迟测速且至少收到一次回应的 IP
+func LivePing(data *PingData) {
+	v := (&CloudflareIPData{PingData: data}).toString()
+	writeLive("P", v[0], v[1], v[2], v[3], v[4], v[6])
+}
+
+// LiveDownloadStart 记录即将开始下载测速的 IP
+func LiveDownloadStart(ip string) {
+	writeLive("D", ip)
+}
+
+// LiveDownloadDone 记录一个完成下载测速的 IP
+func LiveDownloadDone(data *CloudflareIPData) {
+	v := data.toString()
+	writeLive("S", v[0], v[5], v[6])
+}
