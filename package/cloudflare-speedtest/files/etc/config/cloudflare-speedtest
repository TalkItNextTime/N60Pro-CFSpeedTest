config main 'main'
        option enabled '1'
        option interval_hours '6'
        option startup_delay '120'
        option log_level 'info'

config cloudflare 'cloudflare'
        option api_token ''
        option zone ''
        option ttl '1'
        option proxied '0'

config naming 'naming'
        option template 'cf'
        option auto_detect '1'
        option city_override ''
        option isp_override ''
        option fallback_city ''
        option fallback_isp ''

config test 'test'
        option threads '50'
        option attempts '4'
        option download_count '5'
        option download_seconds '10'
        option port '443'
        option test_url 'https://speed.cloudflare.com/__down?bytes=99000000'
        option max_latency_ms '200'
        option max_loss_ratio '0.2'
        option min_speed_mbps '0.01'
        option task_timeout_seconds '900'
        option ip_file '/usr/share/cloudflare-speedtest/ip.txt'
        option ip_source 'cidr'
        option candidate_count '0'
        option test_all '0'

config geo 'geo'
        option request_timeout '8'
        option cache_ttl_hours '72'

config preferred 'preferred'
        option provider 'auto'
        option url_ct 'https://cf.090227.xyz/ct?ips=20'
        option url_cu 'https://cf.090227.xyz/cu?ips=20'
        option url_cmcc 'https://cf.090227.xyz/cmcc?ips=20'
        option url_custom ''
        option timeout '15'
